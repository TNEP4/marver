{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    // frames import _fixtures.ts with the extension (marver's native-TS convention)
    "allowImportingTsExtensions": true{{PATHS}}
  },
  "include": ["."],
  // the host tsconfig excludes "design" (init adds it so the APP's typecheck skips
  // frames); inherited here it would make this project exclude itself (TS18003)
  "exclude": ["node_modules"]
}
